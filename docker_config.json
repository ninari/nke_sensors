{
    "Image": "supportsoftmaster/nke_sensors:nketag",
    "ExposedPorts": {
      "5537/tcp": {}
    },
    "HostConfig": {
      "Privileged": true,
      "NetworkMode": "host",
      "PortBindings": {
        "5537/tcp": [
          { "HostPort": "5537" }
        ]
      },
      "Binds": [
        "/usr/blueos/extensions/nke_sensors:/app/logs",
        "/dev:/dev"
      ],
      "ExtraHosts": [
        { "host.docker.internal": "host-gateway" }
      ]
    }
  }
  